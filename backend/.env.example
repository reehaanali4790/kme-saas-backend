# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Database
# Local:
DATABASE_URL=postgresql://lme:lme@localhost:5432/lme_monitoring
# Railway (add BOTH on the *web* service when Postgres is linked):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}
# Pre-deploy migrations need DATABASE_PUBLIC_URL (private *.railway.internal
# host is not reachable during the migrate step).

# Caching (Upstash Redis TLS connection string)
# REDIS_URL=rediss://default:[TOKEN]@upstash-redis-instance.upstash.io:6379

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# App — required for Railway production deploy
ENVIRONMENT=development
DEBUG=false
# Comma-separated frontend origins (required when ENVIRONMENT=production)
# ALLOWED_ORIGINS=https://your-frontend.up.railway.app,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LC_MONITORING_DAYS=40

# Scheduler — with Redis, a leader lock elects one replica. Without Redis, true on one instance only.
ENABLE_SCHEDULER=true

# SaaS billing (optional — without Stripe, signup provisions tenants directly)
APP_PUBLIC_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPS_MONTHLY=
STRIPE_PRICE_OPS_ANNUAL=
STRIPE_PRICE_TD_MONTHLY=
STRIPE_PRICE_TD_ANNUAL=
# SaaS platform owner (creates login on startup when PASSWORD is set)
PLATFORM_ADMIN_EMAILS=owner@yourcompany.com
PLATFORM_ADMIN_USERNAME=platform-owner
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FULL_NAME=Platform Owner

# Anthropic (Claude Vision - BL/LC/invoice extraction fallback)
ANTHROPIC_API_KEY=

# Google Gemini (primary vision tier for scanned documents)
GEMINI_API_KEY=

# Vessel tracking
VESSEL_API_KEY=
AISSTREAM_API_KEY=

# WhatsApp (Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=+92
WHATSAPP_USE_TEMPLATE=false
WHATSAPP_TEMPLATE_NAME=lme_price_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_PDF_TEMPLATE_NAME=lme_price_alert_pdf
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Email (optional — password reset, invites, dunning-style notices)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@example.com

# Observability (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

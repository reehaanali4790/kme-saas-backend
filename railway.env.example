# Railway backend variables — paste into Railway → Variables (or use as reference).
# Replace placeholder URLs and secrets before deploying.

# --- Postgres (reference linked Postgres service) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}

# --- Required for production ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=
ALLOWED_ORIGINS=https://your-frontend.up.railway.app
APP_PUBLIC_URL=https://your-frontend.up.railway.app

# SaaS platform owner — account created on startup when PASSWORD is set
PLATFORM_ADMIN_EMAILS=owner@yourcompany.com
PLATFORM_ADMIN_USERNAME=platform-owner
PLATFORM_ADMIN_PASSWORD=change-me-after-first-login
PLATFORM_ADMIN_FULL_NAME=Platform Owner

# --- Scheduler ---
# With Redis, a leader lock picks one replica automatically.
# Without Redis, true on a single instance only; false on extra replicas.
ENABLE_SCHEDULER=true

# --- Persistent uploads (attach Railway volume at /data) ---
# RAILWAY_VOLUME_MOUNT_PATH=/data

# --- Redis (optional, Upstash) ---
# REDIS_URL=rediss://default:TOKEN@host.upstash.io:6379

# --- Stripe billing (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPS_MONTHLY=
STRIPE_PRICE_OPS_ANNUAL=
STRIPE_PRICE_TD_MONTHLY=
STRIPE_PRICE_TD_ANNUAL=
PLATFORM_ADMIN_EMAILS=

# --- AI document extraction ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Vessel tracking (optional) ---
VESSEL_API_KEY=
AISSTREAM_API_KEY=

# --- WhatsApp (optional) ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Email (optional — password reset, invites) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@example.com
